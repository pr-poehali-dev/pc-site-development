{
  "tests": [
    {
      "name": "GET without auth returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Create order from site form",
      "method": "POST",
      "path": "/",
      "body": {"name": "Тест Клиент", "phone": "+7 (900) 123-45-67", "telegram": "@testuser", "contact_method": "call", "comment": "Игровой ПК", "source": "test"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject empty request",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "PUT without auth returns 401",
      "method": "PUT",
      "path": "/",
      "body": {"id": 1, "action": "view"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Flush telegram queue",
      "method": "GET",
      "path": "/?action=flush_tg",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Remind stale without key returns 403",
      "method": "GET",
      "path": "/?action=remind_stale&key=wrong",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}