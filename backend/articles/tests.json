{
  "tests": [
    {
      "name": "Список опубликованных статей доступен всем",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Запрос всех статей без токена запрещён",
      "method": "GET",
      "path": "/?all=1",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Создание статьи без токена запрещено",
      "method": "POST",
      "path": "/",
      "body": {"title": "Тест"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "OPTIONS возвращает CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Просмотр несуществующей статьи возвращает 404",
      "method": "POST",
      "path": "/",
      "body": {"action": "view", "id": 999999},
      "expectedStatus": 404,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Голос с некорректными данными отклоняется",
      "method": "POST",
      "path": "/",
      "body": {"action": "vote", "id": 999999, "vote": 5, "visitor_id": "abc"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}